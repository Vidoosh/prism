# Backend + optional services
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Model for domain web research (Gemini + Google Search tool via google-genai)
GEMINI_GOOGLE_SEARCH_MODEL=gemini-3.1-flash-lite
# uvicorn / app log verbosity (DEBUG shows per-request polls like GET /api/pipeline/status)
LOG_LEVEL=INFO
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
# Public read token for Next.js GROQ (optional; can use API token with read scope)
SANITY_API_READ_TOKEN=

# HubSpot CRM (Private App token, starts with pat-)
HUBSPOT_ACCESS_TOKEN=

# Optional — deep links to HubSpot company records
HUBSPOT_PORTAL_ID=

# Optional: Tier-3 scraping fallback
APIFY_API_TOKEN=

# URLs (Docker defaults)
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side fetch from Next container to API (docker compose)
INTERNAL_API_URL=http://backend:8000
# Same value as SANITY_PROJECT_ID — required for Next.js /lp/* (GROQ). Local dev: ./setup.sh writes frontend/.env.local from this file.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional HMAC for /lp/[slug]?t=... (server-only secret; leave empty to disable)
LANDING_PAGE_SECRET=

SANITY_STUDIO_URL=http://localhost:3333

# Sanity Studio (sanity/ folder) — must match SANITY_PROJECT_ID (Vite exposes SANITY_STUDIO_* only)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

FAILED_WRITES_DIR=failed_writes
STORAGE_DIR=storage
BATCH_CONCURRENCY=3
